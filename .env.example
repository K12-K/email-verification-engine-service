NODE_ENV=development
PORT=8080

# SUPABASE: use Transaction Pooler instead of the direct PostgreSQL connection (for free users of supabase)
DATABASE_URL=postgresql://...
REDIS_URL=redis://...

QUEUE_NAME=email-verification
REDIS_KEY_PREFIX=verify-engine

MAX_EMAILS_PER_JOB=1000

DNS_CONCURRENCY=30
SMTP_CONCURRENCY=5

DNS_TIMEOUT_MS=5000
SMTP_TIMEOUT_MS=10000

# Optional. If omitted, the first resolver in Node's configured resolver list is used. Exiting SNS servers [1.1.1.1 or 8.8.8.8]
DNS_SERVER=

DNS_CACHE_MIN_TTL_SECONDS=30
DNS_CACHE_MAX_TTL_SECONDS=86400
DNS_NEGATIVE_CACHE_MAX_TTL_SECONDS=300

SMTP_FROM=verify@yourdomain.com
SMTP_EHLO=verifier.yourdomain.com
SMTP_USE_STARTTLS=true
SMTP_REQUIRE_STARTTLS=false

SMTP_MAX_ATTEMPTS_PER_HOST=2
SMTP_MAX_MX_HOSTS=3
SMTP_RETRY_BASE_DELAY_MS=500
SMTP_DOMAIN_RATE_LIMIT=3
SMTP_DOMAIN_RATE_WINDOW_MS=1000

CATCH_ALL_ENABLED=true
CATCH_ALL_CACHE_SECONDS=3600

RESULT_BATCH_SIZE=100
PROGRESS_EVERY=25

API_KEY=change-me

# API protection
API_RATE_LIMIT=60
API_RATE_WINDOW_MS=60000
