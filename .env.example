NODE_ENV=development

PORT=8080

DATABASE_URL=postgresql://...

REDIS_URL=redis://...

QUEUE_NAME=email-verification

MAX_EMAILS_PER_JOB=1000

DNS_CONCURRENCY=30
SMTP_CONCURRENCY=5

DNS_TIMEOUT_MS=5000
SMTP_TIMEOUT_MS=10000

SMTP_FROM=verify@yourdomain.com
SMTP_EHLO=verifier.yourdomain.com

CATCH_ALL_ENABLED=true

API_KEY=change-me
